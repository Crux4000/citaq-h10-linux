# Citaq H10-3 mainline kernel fragment (6.18 LTS). Merge onto allnoconfig.
CONFIG_ARCH_ROCKCHIP=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
# 6.x arm64 is always RELOCATABLE (EXPERT-only to change); keep KASLR off
CONFIG_RANDOMIZE_BASE=n
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_NR_UARTS=5
CONFIG_SERIAL_8250_RUNTIME_UARTS=5
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
# PL011 only so the same Image can be smoke-tested in qemu-system-aarch64 -M virt
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/tmp/claude-0/-home-claude/863273e3-d746-5be8-b365-d0da0fab7c6d/scratchpad/initramfs.list"
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_BLOCK=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_RESET_CONTROLLER=y
CONFIG_GPIOLIB=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_CLK_RK3368=y
CONFIG_ARM_PSCI_FW=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_CMDLINE="console=ttyS2,115200n8 earlycon=uart8250,mmio32,0xff690000 clk_ignore_unused rdinit=/init loglevel=8 panic=10"
CONFIG_CMDLINE_FORCE=y
